# Copy to .env (or run scripts\init-env.ps1, which generates the secrets for you).
# Environment variables override values in this file. Never commit .env.

# development | test | production. Production refuses to start without real secrets and COOKIE_SECURE=true.
INDUSMIND_ENV=development
SECRET_KEY=change-me-to-64-random-hex-characters

# PostgreSQL (docker-compose.yml). Alternatively set DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db
POSTGRES_DB=indusmind
POSTGRES_USER=indusmind
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Uploads (relative paths are resolved from the repository root) and size limit
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be true when served over HTTPS (always in production)
COOKIE_SECURE=false

# Optional: path to tesseract.exe for OCR of scanned PDFs and images
TESSERACT_CMD=

# Optional tuning (defaults shown)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# LOGIN_RATE_PER_MINUTE=5
# CHAT_RATE_PER_MINUTE=20
# UPLOAD_RATE_PER_MINUTE=30
