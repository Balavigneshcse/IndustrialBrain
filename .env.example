# Copy to .env (or run scripts\init-env.ps1, which generates the secrets for you).
# Environment variables override values in this file. Never commit .env.

# development | test | production. Production refuses to start without real secrets and COOKIE_SECURE=true.
INDUSMIND_ENV=development
SECRET_KEY=change-me-to-64-random-hex-characters

# PostgreSQL (docker-compose.yml). Alternatively set DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db
POSTGRES_DB=indusmind
POSTGRES_USER=indusmind
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis: background job queue and shared rate limits. Leave unset to process uploads inline in the API.
REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_EAGER=true    # force inline processing even when REDIS_URL is set (used by eval runs)

# Uploads (relative paths are resolved from the repository root) and size limit
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# Retrieval models (ONNX, CPU), loaded offline from MODELS_DIR (ml/setup/03_download_models_data.sh)
MODELS_DIR=data/models/fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# MIN_EVIDENCE_SCORE=0.005   # reranker probability below which answers say "insufficient evidence"

# Language model: Ollama on this PC's GPU (scripts\start-ollama.ps1). If it is unreachable, answers
# fall back to the top evidence and say so. LLM_ENABLED=false turns generation off.
# LLM_ENABLED=true
# OLLAMA_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M   # Phase 5 replaces it with the fine-tuned indusmind:4b-v1
# LLM_CONCURRENCY=2            # answers generated at once; match OLLAMA_NUM_PARALLEL
# LLM_MAX_QUEUE=16             # questions waiting for the model before the API answers 429
# LLM_MAX_ANSWER_TOKENS=600
# LLM_CONTEXT_CHUNKS=6         # sources given to the model
# LLM_TEMPERATURE=0.1
# LLM_SEED=42                  # same question + same evidence -> same answer

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be true when served over HTTPS (always in production)
COOKIE_SECURE=false

# Optional: path to tesseract.exe for OCR of scanned PDFs and images
TESSERACT_CMD=

# Optional tuning (defaults shown)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# MAX_FAILED_LOGINS=5
# LOCKOUT_MINUTES=15
# LOGIN_RATE_PER_MINUTE=5
# CHAT_RATE_PER_MINUTE=20
# UPLOAD_RATE_PER_MINUTE=30
