# Environment variables read by the FastAPI server (server/config.py).
# The server does not load a .env file yet (Phase 1 adds that); set these in your shell
# or in the service definition. Relative paths are resolved from the server/ folder.

# Required outside local development: the default secret is public in this repository.
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=sqlite:///../data/indusmind.db
UPLOAD_DIR=../data/uploads
CHROMA_PATH=../data/chroma
ALLOWED_ORIGINS=http://localhost:5173

# Optional: path to tesseract.exe for OCR of scanned PDFs and images
TESSERACT_CMD=
